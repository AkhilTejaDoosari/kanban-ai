# Clerk (Google OAuth sign-in). From the Clerk Dashboard > API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (Clerk native third-party auth integration — see docs/DECISIONS.md ADR-002).
# From the Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cross-user RLS integration test (src/lib/supabase/projects-rls.integration.test.ts).
# Two real Clerk session JWTs for two different signed-in test users. Test is
# skipped when unset.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_USER_A_JWT=
SUPABASE_TEST_USER_B_JWT=

GROQ_API_KEY=

# Playwright E2E suite (npm run test:e2e). Email of an existing signed-up user
# in this Clerk instance — the suite signs them in via a Clerk Testing Token
# (bypasses real Google OAuth entirely, see docs/DECISIONS.md ADR-010), not a
# password. Suite is skipped when unset.
E2E_CLERK_USER_EMAIL=
